<?xml version="1.0" encoding="utf-8"?>
<!--
  apextechnologygroup.io - the static site, served at the IIS site root.
  Adapted from ToxFinder's deploy\web.config.static. GitHub Pages ignores this file.

  The <location path="." inheritInChildApplications="false"> wrapper stops this
  static configuration cascading into the /api child application, which has its
  own pool and its own web.config. Without it /api answers 500.19.

  There is deliberately no rule that strips ".html": app-store listings link to
  /privacy.html, /support.html and /policies/*.html, and those URLs must keep
  answering 200 exactly as they did on GitHub Pages.

  NOTE: XML forbids a double hyphen inside a comment, and a malformed file takes
  the site and /api down with a 500. deploy\Deploy-ApexSite.ps1 parses it before staging.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <staticContent>
        <!-- remove-then-add: IIS throws 500.19 when an extension is already mapped at machine level. -->
        <remove fileExtension=".webp" />
        <mimeMap fileExtension=".webp" mimeType="image/webp" />
        <remove fileExtension=".json" />
        <mimeMap fileExtension=".json" mimeType="application/json" />
        <remove fileExtension=".txt" />
        <mimeMap fileExtension=".txt" mimeType="text/plain; charset=utf-8" />
        <remove fileExtension=".xml" />
        <mimeMap fileExtension=".xml" mimeType="application/xml; charset=utf-8" />

        <!-- Nothing is content-hashed, so everything revalidates against its ETag. -->
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>

      <!-- Serves /new-orleans/ and /nuclear/ from their index.html, as GitHub Pages did. -->
      <defaultDocument enabled="true">
        <files>
          <clear />
          <add value="index.html" />
        </files>
      </defaultDocument>
      <directoryBrowse enabled="false" />

      <urlCompression doStaticCompression="true" doDynamicCompression="false" />

      <httpProtocol>
        <customHeaders>
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
          <!-- No includeSubDomains: other subdomains of this domain are not ours to force onto https. -->
          <add name="Strict-Transport-Security" value="max-age=31536000" />
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>

      <rewrite>
        <rules>
          <!-- Never touch /api: it is a child application with its own handler. MUST be first. -->
          <rule name="skip-api" stopProcessing="true">
            <match url="^api(/.*)?$" />
            <action type="None" />
          </rule>

          <!--
            ACME HTTP-01 must be reachable over PLAIN HTTP, and canonical-host
            below force-redirects every http request to https. Without this rule
            certificate renewal fails silently every 90 days. MUST stay above
            canonical-host.
          -->
          <rule name="skip-acme" stopProcessing="true">
            <match url="^\.well-known/acme-challenge/" />
            <action type="None" />
          </rule>

          <!-- One canonical origin: https, no www. Query strings (UTM tags) are carried over. -->
          <rule name="canonical-host" stopProcessing="true">
            <match url="(.*)" />
            <conditions logicalGrouping="MatchAny">
              <add input="{HTTP_HOST}" pattern="^www\." />
              <add input="{HTTPS}" pattern="^OFF$" />
            </conditions>
            <action type="Redirect" url="https://apextechnologygroup.io/{R:1}" redirectType="Permanent" />
          </rule>
        </rules>
      </rewrite>

    </system.webServer>
  </location>
</configuration>
