<?xml version="1.0" encoding="utf-8"?>
<!--
  Required for IIS sub-application hosting at /api under the static
  apextechnologygroup.io site. Copied from ToxFinder's Upkeep.Api.

  The <location path="." inheritInChildApplications="false"> wrapper prevents
  this app from inheriting the parent site's <system.webServer> config - the
  static site's rewrite rules and mimeMaps - which would otherwise cause
  handler/module conflicts or a 500.19 at startup. The SDK's web.config
  transform preserves it on publish and only updates the <aspNetCore> element.

  DO NOT add an <httpLogging> section here. It is machine-locked on this
  server and turns every successful response into an HTML 500.19.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- 64 KB. Every endpoint takes a small JSON body; IIS rejects anything larger before ASP.NET sees it. -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="65536" />
        </requestFiltering>
      </security>
      <aspNetCore processPath="dotnet" arguments=".\Apex.Site.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
